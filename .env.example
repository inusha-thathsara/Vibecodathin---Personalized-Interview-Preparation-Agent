# Application Environment: development | production | test
APP_ENV=development

# LLM Provider: gemini | ollama | mock (defaults to ollama in dev, gemini in prod)
LLM_PROVIDER=ollama

# Gemini API Configuration (Production / Cloud)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.5-flash

# Ollama Local Configuration (Development)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest

# CORS Allowed Origins (Comma-separated, default * in dev)
CORS_ORIGINS=*
